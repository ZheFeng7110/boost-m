[package]
name        = "{{project.name}}"
version     = "0.1.0"
description = "A C++23 module library built on Boost through mcpplibs.mwrap.boost"
license     = "Apache-2.0"

# The lib-root module defaults to src/<package name>.cppm; this template ships a
# fixed file name, so point the convention at it explicitly.
[lib]
path = "src/lib.cppm"

[dependencies]
"{{self.name}}" = { version = "{{self.version}}", default-features = false, features = ["optional"] }

# gtest comes from the compat namespace; it is only resolved by `mcpp test`.
[dev-dependencies]
compat.gtest = "1.15.2"
