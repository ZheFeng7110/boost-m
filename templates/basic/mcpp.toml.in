[package]
name        = "{{project.name}}"
version     = "0.1.0"
description = "A console app that imports Boost through C++23 named modules"
license     = "Apache-2.0"

# The dependency key is the complete package selector, and the version stays
# tied to the package that shipped this template.
[dependencies]
"{{self.name}}" = { version = "{{self.version}}", default-features = false, features = ["optional"] }
