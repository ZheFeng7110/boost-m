Boost.Bimap examples edited before porting (the oracle runs the edited
program too); tests/bimap/examples_with_boost.cpp's header gives the reasons.
population_bimap: boost::optional spelled out (ambiguous with std::optional),
BOOST_FOREACH over an iterator pair as range-for; mi_hashed_indices:
BOOST_MULTI_INDEX_MEMBER written as the member<> it expands to; range:
using namespace boost::placeholders; serialization: the archive goes to the
temporary directory instead of ./data.

--- a/libs/bimap/example/population_bimap.cpp
+++ b/libs/bimap/example/population_bimap.cpp
@@ -29,7 +29,7 @@
 
 #include <boost/optional.hpp>
 #include <boost/none.hpp>
-#include <boost/foreach.hpp>
+#include <boost/range/iterator_range.hpp>
 #include <boost/assign/list_inserter.hpp>
 
 using namespace boost::bimaps;
@@ -43,7 +43,7 @@ int main()
     typedef bimap<
 
         string,
-        multiset_of< optional<string> >
+        multiset_of< boost::optional<string> >
 
     > bm_type;
 
@@ -62,15 +62,13 @@ int main()
